pipeline {
    agent {
        label 'agent1'
    }
    stages {
        stage('Example Build') {
            steps {
                script{
                sh ---
                    echo 'Hello World'
                ---
            }
          }
        }
        stage('Example Deploy') {
            when {
                branch 'production'
                environment name: 'DEPLOY_TO', value: 'production'
            }
            steps {
                echo 'Deploying'
            }

        }
    }
}